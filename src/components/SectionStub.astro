---
/**
 * Temporary, labelled placeholder for a page section. Each one is replaced by its real component in session 3.
 */
import type { Section } from '../data/content';

interface Props {
  section: Section;
  number: number;
  theme: 'chalk' | 'linen' | 'olive' | 'ink';
  /** The hero carries the page's only <h1>. */
  isHero?: boolean;
}

const { section, number, theme, isHero = false } = Astro.props;
const headingId = `${section.id}-heading`;
const Heading = isHero ? 'h1' : 'h2';
---

<section id={section.id} class={`stub theme-${theme}`} aria-labelledby={headingId}>
  <div class="container">
    <p class="label">Section {number}</p>
    <Heading id={headingId}>{section.label}</Heading>
  </div>
</section>

<style>
  .stub {
    padding-block: var(--section-pad);
    border-bottom: 1px solid color-mix(in srgb, var(--bronze) 40%, transparent);
  }

  .stub .label {
    color: inherit;
    margin-bottom: var(--space-3);
  }
</style>
