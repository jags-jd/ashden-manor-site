---
/**
 * Price estimator. Season and day are native radio buttons (keyboard and screen readers work as
 * standard); the total is announced politely when it changes. All figures come from pricing.ts
 * via the pure functions in lib/estimate.ts. The default (Peak, Saturday) is rendered here, so a
 * number shows even without JavaScript.
 *
 * "Enquire about these dates" writes the choice into the URL (?season=…&day=…) and fires an
 * `estimate:select` event; the enquiry form reads either to prefill its fields.
 */
import Cta from './Cta.astro';
import SectionHeader from './SectionHeader.astro';
import { estimate as copy } from '../data/content';
import { DAYS, DEFAULT_DAY, DEFAULT_SEASON, IS_PLACEHOLDER, SEASONS } from '../data/pricing';
import { estimate, formatGBP } from '../lib/estimate';

const initial = estimate(DEFAULT_SEASON, DEFAULT_DAY);
const venueLabel = (season: string, day: string) => `${season}, ${day}`;
const labels = {
  seasons: Object.fromEntries(SEASONS.map((s) => [s, copy.seasons[s].label])),
  days: Object.fromEntries(DAYS.map((d) => [d, copy.days[d].label])),
};
---

<section id="estimate" class="section theme-olive" aria-labelledby="estimate-heading" data-stack>
  <div class="container layout">
    <SectionHeader
      class="estimate-header"
      sectionId="estimate"
      label={copy.label}
      heading={copy.heading}
      headingId="estimate-heading"
      body={copy.intro}
    />

    <div class="choose">
      <form class="estimator" aria-label={copy.formLabel} data-estimator data-reveal>
        <fieldset>
          <legend class="label">{copy.seasonLegend}</legend>
          <div class="options">
            {
              SEASONS.map((season) => (
                <label class="option">
                  <input class="visually-hidden" type="radio" name="season" value={season} checked={season === DEFAULT_SEASON} />
                  <span class="option-title">{copy.seasons[season].label}</span>
                  <span class="option-detail">{copy.seasons[season].detail}</span>
                </label>
              ))
            }
          </div>
        </fieldset>

        <fieldset>
          <legend class="label">{copy.dayLegend}</legend>
          <div class="options">
            {
              DAYS.map((day) => (
                <label class="option">
                  <input class="visually-hidden" type="radio" name="day" value={day} checked={day === DEFAULT_DAY} />
                  <span class="option-title">{copy.days[day].label}</span>
                </label>
              ))
            }
          </div>
        </fieldset>

        <!-- Phones: the card is below, so repeat the total here. Screen readers hear it from the card. -->
        <p class="summary" aria-hidden="true">
          {copy.resultLabel} <strong data-total-mirror>{formatGBP(initial.total)}</strong>
        </p>
      </form>
    </div>

    <div
      class="result theme-linen"
      data-reveal
      data-result
      data-labels={JSON.stringify(labels)}
    >
      <p class="label result-label" aria-hidden="true">{copy.resultLabel}</p>
      <p class="total" aria-live="polite" aria-atomic="true">
        <span class="visually-hidden">{copy.resultLabel} </span><span data-total>{formatGBP(initial.total)}</span>
      </p>
      <p class="guests">{copy.guestsNote}</p>

      <dl class="breakdown">
        <div class="row">
          <dt>
            {copy.venueHire}
            <span class="row-detail" data-venue-label>
              {venueLabel(copy.seasons[DEFAULT_SEASON].label, copy.days[DEFAULT_DAY].label)}
            </span>
          </dt>
          <dd data-venue>{formatGBP(initial.venueHire)}</dd>
        </div>
        <div class="row">
          <dt>
            {copy.catering}
            <span class="row-detail">{copy.cateringDetail.replace('{price}', formatGBP(initial.cateringPerGuest))}</span>
          </dt>
          <dd data-catering>{formatGBP(initial.catering)}</dd>
        </div>
      </dl>

      <p class="guide">{copy.guide}</p>
      {IS_PLACEHOLDER && <p class="placeholder-note">{copy.placeholderNote}</p>}

      <div data-estimate-cta>
        <Cta href="#enquire" label={copy.cta} variant="primary" />
      </div>
    </div>
  </div>
</section>

<style>
  .layout {
    display: grid;
    gap: var(--space-8);
  }

  .choose {
    display: grid;
    gap: var(--space-7);
  }

  .summary {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-4);
    max-width: none;
    padding-top: var(--space-4);
    border-top: 1px solid color-mix(in srgb, var(--linen) 25%, transparent);
    font-family: var(--font-display);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--stone);
  }

  .summary strong {
    font-size: var(--text-xl);
    font-weight: var(--weight-regular);
    letter-spacing: 0.02em;
    color: var(--chalk);
    font-variant-numeric: tabular-nums;
  }

  /* ---- Choices ---- */
  .estimator {
    display: grid;
    gap: var(--space-6);
  }

  /* min-inline-size: fieldsets otherwise refuse to shrink below their content, overflowing phones. */
  fieldset {
    min-inline-size: 0;
    margin: 0;
    padding: 0;
    border: 0;
  }

  legend {
    margin-bottom: var(--space-3);
    padding: 0;
    color: var(--stone);
  }

  .options {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(9.5rem, 1fr));
    gap: var(--space-2);
  }

  /* position: relative keeps the visually hidden radio inside its pill, so tabbing scrolls to the pill. */
  .option {
    position: relative;
    display: grid;
    align-content: center;
    gap: var(--space-1);
    min-height: 3.25rem;
    padding: var(--space-3) var(--space-4);
    border: 1px solid color-mix(in srgb, var(--linen) 35%, transparent);
    border-radius: 1.75rem;
    cursor: pointer;
    transition:
      background-color var(--duration) var(--ease),
      border-color var(--duration) var(--ease),
      color var(--duration) var(--ease);
  }

  .option:hover {
    border-color: var(--linen);
  }

  .option-title {
    font-family: var(--font-display);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
  }

  .option-detail {
    font-size: var(--text-xs);
    color: var(--stone);
  }

  /* Chosen: Ink on Warm Linen (12.1:1). */
  .option:has(input:checked) {
    border-color: var(--linen);
    background: var(--linen);
    color: var(--ink);
  }

  .option:has(input:checked) .option-detail {
    color: var(--ink);
  }

  .option:has(input:focus-visible) {
    outline: 2px solid var(--linen);
    outline-offset: 3px;
  }

  /* ---- Result card: Ink on Warm Linen, with a gently arched top ---- */
  .result {
    display: grid;
    gap: var(--space-4);
    padding: var(--space-8) var(--space-6) var(--space-7);
    border-radius: 50% 50% var(--radius) var(--radius) / 7rem 7rem var(--radius) var(--radius);
    text-align: center;
  }

  .result-label {
    color: var(--deep-olive);
  }

  .total {
    max-width: none;
    font-family: var(--font-display);
    font-size: clamp(2.75rem, 2rem + 3vw, 4.5rem);
    line-height: 1;
    letter-spacing: 0.02em;
    font-variant-numeric: tabular-nums;
  }

  .guests {
    max-width: none;
    font-style: italic;
  }

  .breakdown {
    display: grid;
    margin: var(--space-3) 0 0;
    text-align: left;
    border-top: 1px solid var(--stone);
  }

  .row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-4);
    padding-block: var(--space-3);
    border-bottom: 1px solid var(--stone);
  }

  dt {
    display: grid;
  }

  .row-detail {
    font-size: var(--text-xs);
    font-style: italic;
  }

  dd {
    margin: 0;
    font-weight: var(--weight-semibold);
    font-variant-numeric: tabular-nums;
  }

  .guide,
  .placeholder-note {
    max-width: none;
    font-size: var(--text-sm);
  }

  /* Visible while the prices are placeholders (IS_PLACEHOLDER in pricing.ts). */
  .placeholder-note {
    justify-self: center;
    padding: var(--space-2) var(--space-4);
    border: 1px solid var(--deep-olive);
    border-radius: var(--radius-pill);
    font-style: italic;
  }

  [data-estimate-cta] {
    margin-top: var(--space-3);
  }

  /*
   * Desktop: headline across the top, then the choices and the card side by side, so the total
   * is always in view while choosing.
   */
  @media (min-width: 56rem) {
    .layout {
      grid-template-columns: 6fr 5fr;
      column-gap: var(--space-10);
      align-items: center;
    }

    .layout :global(.estimate-header) {
      grid-column: 1 / -1;
    }

    .layout :global(.estimate-header h2) {
      max-width: 22ch;
    }

    .summary {
      display: none;
    }

    .result {
      padding-inline: var(--space-7);
    }
  }
</style>

<script>
  import { estimate, formatGBP, isDay, isSeason, selectionToSearch } from '../lib/estimate';

  for (const form of document.querySelectorAll<HTMLFormElement>('[data-estimator]')) {
    const section = form.closest('section');
    const result = section?.querySelector<HTMLElement>('[data-result]');
    if (!section || !result) continue;

    const total = result.querySelector('[data-total]');
    const mirror = form.querySelector('[data-total-mirror]');
    const venue = result.querySelector('[data-venue]');
    const venueLabel = result.querySelector('[data-venue-label]');
    const catering = result.querySelector('[data-catering]');
    const labels = JSON.parse(result.dataset.labels ?? '{}') as {
      seasons: Record<string, string>;
      days: Record<string, string>;
    };

    const selection = () => {
      const data = new FormData(form);
      const season = data.get('season');
      const day = data.get('day');
      return isSeason(season) && isDay(day) ? { season, day } : null;
    };

    const update = () => {
      const chosen = selection();
      if (!chosen) return;
      const result = estimate(chosen.season, chosen.day);
      // Only the total sits in the live region, so screen readers hear just the new figure.
      if (total) total.textContent = formatGBP(result.total);
      if (mirror) mirror.textContent = formatGBP(result.total);
      if (venue) venue.textContent = formatGBP(result.venueHire);
      if (catering) catering.textContent = formatGBP(result.catering);
      if (venueLabel) venueLabel.textContent = `${labels.seasons[chosen.season]}, ${labels.days[chosen.day]}`;
    };

    form.addEventListener('change', update);
    form.addEventListener('submit', (event) => event.preventDefault());

    // Carry the choice to the enquiry form: in the URL (survives a reload) and as an event.
    section.querySelector('[data-estimate-cta] a')?.addEventListener('click', () => {
      const chosen = selection();
      if (!chosen) return;
      history.replaceState(null, '', `${selectionToSearch(chosen, location.search)}#enquire`);
      window.dispatchEvent(new CustomEvent('estimate:select', { detail: chosen }));
    });

    update();
  }
</script>
