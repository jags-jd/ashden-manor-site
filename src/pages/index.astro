---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Preloader from '../components/Preloader.astro';
import SectionProgress from '../components/SectionProgress.astro';
import Hero from '../components/Hero.astro';
import ExclusiveUse from '../components/ExclusiveUse.astro';
import Spaces from '../components/Spaces.astro';
import Food from '../components/Food.astro';
import Why100 from '../components/Why100.astro';
import YourDay from '../components/YourDay.astro';
import Pets from '../components/Pets.astro';
import NotAHotel from '../components/NotAHotel.astro';
import Estimate from '../components/Estimate.astro';
import Enquire from '../components/Enquire.astro';
import Faq from '../components/Faq.astro';
import Footer from '../components/Footer.astro';

// Section order and ids come from `sections` in src/data/content.ts (the menu and 01, 02, 03 markers use it).
// Dark and light sections alternate, so each one reads clearly as it slides over the last.
---

<Base>
  <Preloader />
  <Header />
  <main id="main">
    <Hero />
    <ExclusiveUse />
    <Spaces />
    <Food />
    <Why100 />
    <YourDay />
    <Pets />
    <NotAHotel />
    <Estimate />
    <Enquire />
    <Faq />
  </main>
  <Footer />
  <SectionProgress />
</Base>

<script>
  import { initMotion } from '../lib/motion';

  // After first paint, when the browser is idle: keeps start-up work off the critical path.
  if ('requestIdleCallback' in window) requestIdleCallback(() => initMotion(), { timeout: 800 });
  else setTimeout(initMotion, 100);
</script>
